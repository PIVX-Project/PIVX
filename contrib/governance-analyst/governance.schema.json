        },
        "required": [
          "id",
          "name",
          "proposer",
          "chain_hash",
          "chain_verified",
          "summary",
          "deliverables",
          "cost",
          "scores",
          "history",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
